{
  "name": "btq-browser-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bitcoin Quantum (BTQ) browser wallet \u2014 post-quantum ML-DSA-44 / P2MR, testnet",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "demo:video": "RECORD_VIDEO=1 playwright test tests/e2e/smoke.spec.ts && sh scripts/stitch-demo.sh",
    "playwright:install": "playwright install chromium",
    "dev": "vite",
    "build": "vite build",
    "vectors": "tsx scripts/gen-vectors.ts"
  },
  "dependencies": {
    "@noble/hashes": "^1.7.1",
    "@noble/post-quantum": "^0.3.0",
    "@scure/base": "^1.2.4",
    "@scure/bip39": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.5"
  }
}
